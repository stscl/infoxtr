  dplyr::mutate(soiltype = factor(soiltype)) |> 
  ggplot2::ggplot() +
  ggplot2::geom_sf(ggplot2::aes(fill = soiltype), lwd = .1, color = 'grey') +
  ggplot2::scale_fill_manual(
    values = c("#00bfbf", "#7aff00", "#ffc100",
               "#cf8035", "#c0abab")
  ) +
